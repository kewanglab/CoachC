# Copy to .env (never commit it).
# Claude: the coaching step (coach/coach.py) and the pipeline's court marking and naming (dsa.opus) both read this.
ANTHROPIC_API_KEY=
# Where the pipeline keeps videos, weights and outputs (an external drive works well; expect tens of GB).
DSA_DATA=/path/to/data
# Your project entry for the pipeline (no edits to upstream code needed).
DSA_PROJECTS=pipeline/my_project.json
